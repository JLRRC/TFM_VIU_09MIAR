{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "system_state_manager.yaml",
  "description": "Schema for ur5_bringup/config/system_state_manager.yaml. Audit-v4.1 F2 (2026-05-09): typed jsonschema gating. Format ROS 2 params (node_name → ros__parameters → keys).",
  "type": "object",
  "additionalProperties": false,
  "required": ["system_state_manager"],
  "properties": {
    "system_state_manager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ros__parameters"],
      "properties": {
        "ros__parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "world_name",
            "model_name",
            "base_frame",
            "world_frame",
            "ee_frame"
          ],
          "properties": {
            "world_name": {"type": "string"},
            "model_name": {"type": "string"},
            "base_frame": {"type": "string"},
            "world_frame": {"type": "string"},
            "ee_frame": {"type": "string"},
            "pose_topic": {"type": "string"},
            "camera_topic": {"type": "string"},
            "controller_manager": {"type": "string"},
            "required_controllers": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 1
            },
            "moveit_required": {"type": "boolean"},
            "moveit_service_names": {
              "type": "array",
              "items": {"type": "string"}
            },
            "moveit_check_sec": {"type": "number", "minimum": 0},
            "clock_timeout_sec": {"type": "number", "minimum": 0},
            "pose_timeout_sec": {"type": "number", "minimum": 0},
            "camera_timeout_sec": {"type": "number", "minimum": 0},
            "tf_timeout_sec": {"type": "number", "minimum": 0},
            "geometry_required": {"type": "boolean"},
            "geometry_tool_frame": {"type": "string"},
            "geometry_offset_tol_m": {"type": "number", "minimum": 0},
            "geometry_pair_tol_m": {"type": "number", "minimum": 0},
            "controller_check_sec": {"type": "number", "minimum": 0},
            "controller_future_timeout_sec": {"type": "number", "minimum": 0},
            "state_publish_hz": {"type": "number", "exclusiveMinimum": 0},
            "startup_timeout_sec": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  }
}
