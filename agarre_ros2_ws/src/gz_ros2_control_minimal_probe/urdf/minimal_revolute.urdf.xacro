<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="minimal_revolute">

  <!-- =============== Geometry constants =============== -->
  <xacro:property name="base_h"  value="0.10"/>
  <xacro:property name="link_l"  value="0.50"/>
  <xacro:property name="link_w"  value="0.05"/>

  <!-- =============== world / base =============== -->
  <link name="world"/>

  <!-- Base fija al world. type=fixed -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_h/2}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${link_w} ${link_w} ${base_h}"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${link_w} ${link_w} ${base_h}"/></geometry>
    </collision>
  </link>

  <!-- =============== revolute joint1 =============== -->
  <!-- Eje horizontal Y para que la gravedad sí pueda actuar (test honesto).
       Si eje fuese Z (vertical), no habría gravedad alrededor del eje y
       no podríamos distinguir entre "joint stuck" y "no gravity torque". -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${base_h/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="3.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="link1">
    <inertial>
      <origin xyz="0 0 ${link_l/2}" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="${0.5/12.0*(link_w*link_w + link_l*link_l)}" ixy="0" ixz="0"
        iyy="${0.5/12.0*(link_w*link_w + link_l*link_l)}" iyz="0"
        izz="${0.5/12.0*(link_w*link_w + link_w*link_w)}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${link_l/2}" rpy="0 0 0"/>
      <geometry><box size="${link_w} ${link_w} ${link_l}"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link_l/2}" rpy="0 0 0"/>
      <geometry><box size="${link_w} ${link_w} ${link_l}"/></geometry>
    </collision>
  </link>

  <!-- =============== ros2_control (gz_ros2_control) =============== -->
  <ros2_control name="MinimalRevoluteSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- =============== Gazebo plugin =============== -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find gz_ros2_control_minimal_probe)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
