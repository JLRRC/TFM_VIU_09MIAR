# Audit 2026-05-10 (Action 10): config canónico de cobertura.
# Uso (con stack instalado):
#   colcon test --packages-select tfm_orchestrator \
#     --pytest-args --cov=tfm_orchestrator --cov-report=term --cov-fail-under=75
#
# CI publica HTML report a artifacts (Action 22).
[run]
branch = True
source =
    tfm_orchestrator
    tfm_grasping
    ur5_tools
omit =
    */test/*
    */tests/*
    */__pycache__/*
    */build/*
    */install/*
    */log/*

[report]
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    raise NotImplementedError
    \.\.\.
fail_under = 75
show_missing = True
skip_covered = False
precision = 1

[html]
directory = coverage_html
