<!--
  ur5.srdf
  ========
  Configuración MoveIt 2 para UR5 + RG2.

  Decisiones de diseño:
  - grupo "ur5_arm": tip_link = rg2_pinch_center (NO tool0)
    → MoveIt planifica IK hacia el TCP operativo del gripper.
  - grupo "rg2_gripper": los dos joints prismáticos de los dedos.
  - end_effector "gripper": asocia rg2_gripper a ur5_arm con parent_link=tool0.
  - virtual_joint: world (fixed) → base_link.

  IMPORTANTE: rg2_tcp ha sido eliminado del URDF. No referenciar ese frame.
  El TCP operativo es exclusivamente rg2_pinch_center.
-->
<robot name="ur5_rg2">

  <!-- Virtual joint fija el robot al world frame de MoveIt -->
  <virtual_joint name="world_joint"
                 parent_frame="world"
                 child_link="base_link"
                 type="fixed"/>

  <!-- ── Grupo principal: brazo UR5 ──────────────────────────────────── -->
  <!--
    tip_link = rg2_pinch_center:
      MoveIt resolverá IK para que rg2_pinch_center alcance el target.
      El KDL solver recorre la cadena completa incluyendo joints fijos
      (rg2_mount_joint, rg2_pinch_center_joint) correctamente.
  -->
  <group name="ur5_arm">
    <chain base_link="base_link" tip_link="rg2_pinch_center"/>
  </group>

  <!-- ── Grupo gripper: dedos RG2 ─────────────────────────────────────── -->
  <group name="rg2_gripper">
    <joint name="rg2_finger_joint1"/>
    <joint name="rg2_finger_joint2"/>
  </group>

  <!-- ── End effector ─────────────────────────────────────────────────── -->
  <!--
    parent_link = tool0: punto de acoplamiento entre brazo y gripper en SRDF.
    group = rg2_gripper: el EE actúa sobre los joints de los dedos.
    El TCP real de planning sigue siendo rg2_pinch_center (definido por tip_link).
  -->
  <end_effector name="gripper"
                parent_link="tool0"
                group="rg2_gripper"
                parent_group="ur5_arm"/>

  <!-- ── Estados predefinidos ─────────────────────────────────────────── -->
  <group_state name="home" group="ur5_arm">
    <joint name="shoulder_pan_joint"  value="0.0"/>
    <joint name="shoulder_lift_joint" value="-1.5707963267948966"/>
    <joint name="elbow_joint"         value="0.0"/>
    <joint name="wrist_1_joint"       value="-1.5707963267948966"/>
    <joint name="wrist_2_joint"       value="0.0"/>
    <joint name="wrist_3_joint"       value="0.0"/>
  </group_state>

  <group_state name="gripper_open" group="rg2_gripper">
    <joint name="rg2_finger_joint1" value="0.0425"/>
    <joint name="rg2_finger_joint2" value="0.0425"/>
  </group_state>

  <group_state name="gripper_closed" group="rg2_gripper">
    <joint name="rg2_finger_joint1" value="0.0"/>
    <joint name="rg2_finger_joint2" value="0.0"/>
  </group_state>

  <!-- ── Deshabilitar colisiones ──────────────────────────────────────── -->
  <!-- Pares adyacentes -->
  <disable_collisions link1="base_link_inertia"  link2="shoulder_link"     reason="Adjacent"/>
  <disable_collisions link1="shoulder_link"       link2="upper_arm_link"    reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link"      link2="forearm_link"      reason="Adjacent"/>
  <disable_collisions link1="forearm_link"        link2="wrist_1_link"      reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link"        link2="wrist_2_link"      reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link"        link2="wrist_3_link"      reason="Adjacent"/>
  <!-- Gripper -->
  <disable_collisions link1="wrist_3_link"       link2="rg2_base_link"     reason="Adjacent"/>
  <disable_collisions link1="rg2_base_link"      link2="rg2_finger_link1"  reason="Adjacent"/>
  <disable_collisions link1="rg2_base_link"      link2="rg2_finger_link2"  reason="Adjacent"/>
  <disable_collisions link1="rg2_finger_link1"   link2="rg2_finger_link2"  reason="Never"/>
  <!-- Muñeca vs gripper (por límites de joints nunca colisionan) -->
  <disable_collisions link1="wrist_1_link"       link2="rg2_base_link"     reason="Never"/>
  <disable_collisions link1="wrist_2_link"       link2="rg2_base_link"     reason="Never"/>
  <!-- Pares lejanos del UR5 (geometría estándar) -->
  <disable_collisions link1="base_link_inertia"  link2="upper_arm_link"    reason="Never"/>
  <disable_collisions link1="base_link_inertia"  link2="forearm_link"      reason="Never"/>
  <disable_collisions link1="shoulder_link"      link2="forearm_link"      reason="Never"/>
  <disable_collisions link1="shoulder_link"      link2="wrist_1_link"      reason="Never"/>
  <disable_collisions link1="upper_arm_link"     link2="wrist_1_link"      reason="Never"/>
  <disable_collisions link1="upper_arm_link"     link2="wrist_2_link"      reason="Never"/>

</robot>
